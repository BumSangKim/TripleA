# .env.example - API 키 설정 템플릿
# 이 파일을 복사하여 .env 로 만들고 실제 키를 입력하세요:
#   cp .env.example .env

# 한국은행 ECOS OpenAPI 키 (https://ecos.bok.or.kr/api/)
ECOS_API_KEY=YOUR_ECOS_API_KEY

# FRED (St. Louis Fed) API 키 (https://fred.stlouisfed.org/docs/api/)
FRED_API_KEY=YOUR_FRED_API_KEY

# Naver 뉴스 API (https://developers.naver.com)
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET

# KIPRIS 특허청 API 키 (https://plus.kipris.or.kr)
KIPRIS_API_KEY=YOUR_KIPRIS_API_KEY

# KOSIS (국가통계포털) API 키 혹은 공공데이터포털 키
KOSIS_API_KEY=YOUR_KOSIS_API_KEY
PUBLIC_DATA_API_KEY=YOUR_PUBLIC_DATA_API_KEY

# 텔레그램 봇 토큰 (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# 텔레그램 수신 채팅 ID (개인: 숫자, 그룹: 음수)
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Financial Modeling Prep API 키 (https://financialmodelingprep.com)
# MSFT/GOOGL/META/AMZN Hyperscaler CapEx 수집용
FMP_API_KEY=YOUR_FMP_API_KEY

# Google Gemini API 키 (https://aistudio.google.com/app/apikey)
# SEC EDGAR 8-K IR 자료 한국어 요약용 (무료: Gemini 3.1 Flash-Lite 사용)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 한국투자증권 OpenAPI 키 (https://apiportal.koreainvestment.com)
# 국내 주식 OHLCV 데이터 수집용 (실전 또는 모의투자 계좌 필요)
KIS_APP_KEY=YOUR_KIS_APP_KEY
KIS_APP_SECRET=YOUR_KIS_APP_SECRET
KIS_ISDEMO=false  # 모의투자: true, 실전투자: false
