# .gitignore
# API 키 및 비밀 정보 - 절대 커밋 금지
API_KEY/
.env
*.env
.env.*
!.env.example

# Python 캐시
__pycache__/
*.py[cod]
*.pyo
*.pyc
.mypy_cache/
.pytest_cache/

# 가상환경
.venv/
venv/
env/
ENV/

# 자동 생성 파일
*.db
*.log
*.sqlite3
data/pipeline.log
.scheduler.pid

# data/ 런타임 파일 (DB, 로그) — .gitkeep만 추적
data/*.db
data/*.log
data/*.sqlite3

# 구 디렉토리 (제거 후에도 OS 캐시에 남을 수 있음)
economic_data_pipeline/
quant_trading_system/

# OS 파일
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride

# IDE
.idea/
.vscode/
*.swp
*.swo

# 빌드/배포
dist/
build/
*.egg-info/
