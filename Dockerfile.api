# Dockerfile.api — FastAPI 백엔드 컨테이너
FROM python:3.12-slim

WORKDIR /app

# 의존성 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 소스 복사 (data 볼륨은 런타임에 마운트)
COPY api/ ./api/
COPY config/ ./config/
COPY config.yaml ./

# 데이터 디렉터리 생성
RUN mkdir -p data

EXPOSE 8000

ENV PYTHONPATH=/app
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
