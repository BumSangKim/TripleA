# Dockerfile.api — FastAPI 백엔드 컨테이너
FROM python:3.12-slim

WORKDIR /app

# 의존성 설치
COPY requirements.txt .
RUN pip install --no-cache-dir \
    fastapi>=0.115.0 \
    "uvicorn[standard]>=0.30.0" \
    "python-jose[cryptography]>=3.3.0" \
    "passlib[bcrypt]>=1.7.4" \
    python-multipart>=0.0.9 \
    requests>=2.31.0 \
    python-dotenv>=1.0.0 \
    pandas>=2.0.0 \
    pyyaml>=6.0.0

# 소스 복사 (data 볼륨은 런타임에 마운트)
COPY api/ ./api/
COPY config/ ./config/
COPY storage/ ./storage/
COPY config.yaml ./

# 데이터 디렉터리 생성
RUN mkdir -p data

EXPOSE 8000

ENV PYTHONPATH=/app
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
